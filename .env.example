# Chave da API Anthropic. Se deixar em branco, o app roda em MODO SIMULADO
# (respostas humanizadas determinísticas, sem chamar nenhum LLM externo).
ANTHROPIC_API_KEY=

# Modelo Claude usado pelos agentes (ver docs/ARQUITETURA.md para trade-offs).
PONEIU_MODEL_NAME=claude-sonnet-5

# Temperatura usada nas respostas humanizadas do agente geral.
PONEIU_TEMPERATURE=0.4
